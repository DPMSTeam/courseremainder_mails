<?xml version="1.0" encoding="UTF-8"?>
<XMLDB PATH="local/courseremainder_mails/db"
       VERSION="2026070700"
       COMMENT="XMLDB file for local_courseremainder_mails"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">

    <TABLES>

        <TABLE NAME="local_courseremainder_log"
               COMMENT="Stores course reminder email logs">

            <FIELDS>

                <FIELD NAME="id"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"
                       SEQUENCE="true"/>

                <FIELD NAME="userid"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"
                       DEFAULT="0"/>

                <FIELD NAME="email"
                       TYPE="char"
                       LENGTH="255"
                       NOTNULL="true"
                       DEFAULT=""/>

                <FIELD NAME="courseid"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"
                       DEFAULT="0"/>

                <FIELD NAME="enrol_id"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"
                       DEFAULT="0"/>

                <FIELD NAME="day"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"
                       DEFAULT="0"/>

                <FIELD NAME="expairy_notification_type"
                       TYPE="char"
                       LENGTH="50"
                       NOTNULL="true"
                       DEFAULT=""/>

                <FIELD NAME="status"
                       TYPE="int"
                       LENGTH="1"
                       NOTNULL="true"
                       DEFAULT="0"
                       COMMENT="0 = Failed, 1 = Success"/>

                <FIELD NAME="deleted"
                       TYPE="int"
                       LENGTH="1"
                       NOTNULL="true"
                       DEFAULT="0"/>

                <FIELD NAME="modifierid"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"
                       DEFAULT="0"/>

                <FIELD NAME="timesent"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"
                       DEFAULT="0"/>

                <FIELD NAME="timecreated"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"
                       DEFAULT="0"/>

                <FIELD NAME="timemodified"
                       TYPE="int"
                       LENGTH="10"
                       NOTNULL="true"
                       DEFAULT="0"/>

            </FIELDS>

            <KEYS>

                <KEY NAME="primary"
                     TYPE="primary"
                     FIELDS="id"/>

                <KEY NAME="userid_fk"
                     TYPE="foreign"
                     FIELDS="userid"
                     REFTABLE="user"
                     REFFIELDS="id"/>

                <KEY NAME="courseid_fk"
                     TYPE="foreign"
                     FIELDS="courseid"
                     REFTABLE="course"
                     REFFIELDS="id"/>

                <KEY NAME="enrolid_fk"
                     TYPE="foreign"
                     FIELDS="enrol_id"
                     REFTABLE="enrol"
                     REFFIELDS="id"/>

            </KEYS>

            <INDEXES>

                <INDEX NAME="userid_idx"
                       UNIQUE="false"
                       FIELDS="userid"/>

                <INDEX NAME="courseid_idx"
                       UNIQUE="false"
                       FIELDS="courseid"/>

                <INDEX NAME="enrolid_idx"
                       UNIQUE="false"
                       FIELDS="enrol_id"/>

                <INDEX NAME="status_idx"
                       UNIQUE="false"
                       FIELDS="status"/>

            </INDEXES>

        </TABLE>

    </TABLES>

</XMLDB>